{
  "name": "personal-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "个人工作台 · 晨雾奶油 — 本地优先的效率与生活工作台",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "build": "node build.js",
    "build:cloud": "node build.js --cloud",
    "build:tauri": "node build.js --tauri",
    "build:ext": "node tools/build-extension.mjs",
    "build:app": "node build.js --app",
    "apk": "node build.js --app && cd mobile && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "dev": "node tools/dev-server.js",
    "watch": "node tools/watch.mjs",
    "lint": "oxlint js build.js tools",
    "lint:fix": "oxlint --fix js build.js tools",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:smoke": "node tools/test-smoke.mjs",
    "test:immersive": "node tools/test-immersive.mjs",
    "photos": "node tools/export-test-photos.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "puppeteer-core": "^25.10.0"
  }
}
